  "narrative": {
    "northStar": "研究社区报刊",
    "overview": "以纸白、钴蓝与墨色建立中文具身智能社区的出版物气质。品牌字标与实际项目图承担识别，细分隔线、明确列宽和可读的中文正文承担结构；正文、项目与学术分享共享一套平面视觉语言。\n\n用户明确选择 home-comp-2，并批准用原有四个项目素材替代视觉稿中的生成图。落地实现保留原素材内容：EGO 项目图仍是插画，不被包装成实拍。选定首页的具体版面属于 .impeccable/surfaces/home.md，不是所有新页面必须复制的模板。",
    "keyCharacteristics": [
      "纸白底、钴蓝强调、墨色正文与细规则线。",
      "凝缩英文品牌字标搭配清晰的中文无衬线正文。",
      "真实项目图、独立阅读列与直接的文本链接。",
      "平面排版；有界动效仅作状态反馈和局部氛围。"
    ],
    "rules": [
      {
        "name": "The Cobalt Signal Rule",
        "body": "钴蓝承担品牌、重要标题、可执行链接与重点数据；墨色和中性灰维持阅读层级。",
        "section": "colors"
      },
      {
        "name": "The Rules Before Panels Rule",
        "body": "用列宽、留白和一像素规则线组织内容，不用浮起的容器替代信息结构。",
        "section": "elevation"
      },
      {
        "name": "The Real Source Rule",
        "body": "项目图片和学术内容沿用可追溯素材；不把生成图、假二维码或未确认数据写成新的事实背书。",
        "section": "components"
      }
    ],
    "dos": [
      "Do 使用已托管的 Noto Sans SC 中文字体与 Barlow Condensed 字标，保持中文和拉丁文各自清晰的层级。",
      "Do 让项目照片、插画、学术信息保留原身份，并明确缺失的入群二维码。",
      "Do 保持文本链接可见、焦点环明确，内容不依赖 React 岛才能访问。",
      "Do 在小屏把阅读双栏收成单栏，保留所有正文与参会信息。"
    ],
    "donts": [
      "Don't 用渐变字、光晕、阴影圆角卡片替代现有的平面出版物语言。",
      "Don't 把首页巨型字标、照片裁切或具体首屏叙事当作每条路由的模板。",
      "Don't 在正文层放置持续跟随鼠标的装饰；Threads 仅存在于加入区域，减少动态偏好与窄屏不运行。",
      "Don't 猜造讲者照片、社交账号、二维码、会议链接或项目表现。"
    ]
  }
}